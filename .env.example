# M/S Afrin Traders — SAFE EXAMPLE ONLY. Never put real credentials in a ZIP.
# Copy to .env only for a NEW local installation. Preserve the existing .env on upgrades.
APP_NAME="M/S Afrin Traders"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Set to actual local XAMPP MySQL port (the supplied export was made on 3307).
DB_PORT=3306
DB_DATABASE=intrigue_erp_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Backups remain local unless your encrypted off-site destination is configured.
ERP_BACKUP_OFFSITE_ENABLED=false
ERP_BACKUP_REQUIRE_OFFSITE=false
ERP_BACKUP_DRILL_ENABLED=false
ERP_ALLOW_WEB_RESTORE=false
ERP_ALLOW_LEGACY_BACKUP_RESTORE=false
